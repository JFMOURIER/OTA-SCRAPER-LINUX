#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
USER_UNIT_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
OLD_TIMERS=(
  ota-scraper-near.timer
  ota-scraper-medium.timer
  ota-scraper-long.timer
)
USER_UNITS=(
  ota-scheduler-dispatch.service
  ota-scheduler-dispatch.timer
  ota-scraper-run@.service
  ota-drive-retry@.service
  ota-ui-near.service
  ota-ui-medium.service
  ota-ui-long.service
)

case "${1:-status}" in
  prepare)
    "$ROOT/.venv/bin/python" "$ROOT/tools/ota_scheduler.py" prepare
    "$ROOT/.venv/bin/python" "$ROOT/tools/ota_scheduler.py" initialize-schedules
    ;;
  preflight)
    exec "$ROOT/.venv/bin/python" "$ROOT/tools/ota_scheduler.py" preflight
    ;;
  enable-concurrency)
    exec "$ROOT/.venv/bin/python" "$ROOT/tools/ota_scheduler.py" enable-concurrency
    ;;
  install-user)
    mkdir -p "$USER_UNIT_DIR"
    for unit in "${USER_UNITS[@]}"; do
      install -m 0644 "$ROOT/systemd/$unit" "$USER_UNIT_DIR/$unit"
    done
    systemctl --user daemon-reload
    echo "Installed configurable dispatcher, run template, and three UI user units."
    ;;
  enable-dispatcher)
    "$ROOT/.venv/bin/python" "$ROOT/tools/ota_scheduler.py" migration-status
    "$ROOT/.venv/bin/python" "$ROOT/tools/ota_scheduler.py" initialize-schedules
    systemctl --user enable --now ota-scheduler-dispatch.timer
    ;;
  disable-dispatcher)
    systemctl --user disable --now ota-scheduler-dispatch.timer
    ;;
  disable-all-schedules)
    exec "$ROOT/.venv/bin/python" "$ROOT/tools/ota_scheduler.py" disable-all-schedules
    ;;
  start-uis)
    systemctl --user start \
      ota-ui-near.service \
      ota-ui-medium.service \
      ota-ui-long.service
    ;;
  stop-uis)
    systemctl --user stop \
      ota-ui-near.service \
      ota-ui-medium.service \
      ota-ui-long.service
    ;;
  enable-uis)
    systemctl --user enable --now \
      ota-ui-near.service \
      ota-ui-medium.service \
      ota-ui-long.service
    ;;
  disable-timers)
    sudo systemctl disable --now "${OLD_TIMERS[@]}"
    ;;
  status)
    "$ROOT/.venv/bin/python" "$ROOT/tools/ota_scheduler.py" schedule-status
    "$ROOT/.venv/bin/python" "$ROOT/tools/ota_scheduler.py" migration-status || true
    systemctl --user --no-pager --full status \
      ota-scheduler-dispatch.timer \
      ota-scheduler-dispatch.service \
      'ota-scraper-run@*.service' || true
    ;;
  *)
    echo "usage: scripts/ota-scheduler {prepare|preflight|enable-concurrency|install-user|enable-dispatcher|disable-dispatcher|disable-all-schedules|start-uis|stop-uis|enable-uis|disable-timers|status}" >&2
    exit 2
    ;;
esac
